# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# contract build artifacts
**/cache/
**/artifacts/
.module_cache/

# package locks inside nested packages (keep root only)
apps/**/package-lock.json
packages/**/package-lock.json

# script generated files and dev artifacts
.env.local
.env.development.local
.env.test.local
.env.production.local

# test integration artifacts (auto-generated)
**/test_integration_sync/

# build and activity logs
.build-log
.activity_log
deploy_log.txt
verify_log.txt

# local developer notes
QUICK_FIX_PROMPT.md

# auto-generated module spam (never commit)
src/features/
src/lib/modules/
src/types/
src/api/dummy_commits.txt
apps/frontend/src/features/
apps/frontend/src/lib/modules/
apps/frontend/src/types/modules/
packages/core/src/lib/modules/
packages/core/src/types/
packages/sdk/src/lib/modules/
packages/sdk/src/types/
